  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "kill-ports": "node -e \"const {killPortProcesses} = require('./utils/portManager'); killPortProcesses(3008).then(() => console.log('✅ Ports cleared')).catch(console.error)\"",
